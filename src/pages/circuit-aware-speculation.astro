---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = 'Acceptance Prediction before Drafting';
const pageDescription =
	'In speculative decoding, every control signal in use is computed after the draft compute is spent. The target model already holds the answer one round early: a linear probe on its cached frontier state predicts next-round acceptance before any draft runs, adding +0.04 to +0.11 AUROC over a hardened baseline.';

const headline = [
	{ value: '+0.04 – +0.11', label: 'AUROC added over a hardened pre-round baseline, all three settings', tone: 'win' },
	{
		value: 'Scored once',
		label: 'Frozen test under strict dev→test transfer: +0.056 / +0.103 / +0.039',
		tone: 'win',
	},
	{ value: '2 – 10×', label: 'Steering the direction disrupts real acceptance vs. matched controls', tone: 'win' },
	{ value: '0.53 – 0.56', label: 'Equal-capacity random controls — the lift is information, not size', tone: 'neutral' },
];

const timeline = [
	{
		step: 'Round r−1 is checked',
		body: "The target's forward pass builds a state for every token it reads. At the last kept token — the frontier — that state is left sitting in memory.",
		mark: 'free',
	},
	{
		step: 'Read the frontier state',
		body: 'One 14k-dimensional dot product, ~16 µs, about 0.015% of a decode round. No draft compute has been spent yet. This is where our signal lives.',
		mark: 'ours',
	},
	{
		step: 'Round r drafts',
		body: 'Every control signal we could find in prior work — draft entropy, acceptance heads, confidence schedulers, tree pruners — first becomes readable here, after the cost is paid.',
		mark: 'prior',
	},
];

const frozenRows = [
	{
		setting: 'Qwen-v1',
		n: '11,982',
		p1: '+0.076',
		p1ci: '[+0.063, +0.089]',
		p2: '+0.056',
		p2ci: '[+0.041, +0.070]',
		shift: '0.660 → 0.716',
		ctrl: '0.542',
	},
	{
		setting: 'Qwen-v2',
		n: '7,191',
		p1: '+0.092',
		p1ci: '[+0.073, +0.111]',
		p2: '+0.103',
		p2ci: '[+0.083, +0.124]',
		shift: '0.626 → 0.729',
		ctrl: '0.528',
	},
	{
		setting: 'Llama-v1',
		n: '9,610',
		p1: '+0.053',
		p1ci: '[+0.037, +0.070]',
		p2: '+0.039',
		p2ci: '[+0.023, +0.057]',
		shift: '0.713 → 0.752',
		ctrl: '0.559',
	},
];

const lengthRows = [
	{ k: '1', qwen1: '+0.073', qwen2: '+0.103', llama: '+0.065', tone: ['win', 'win', 'win'] },
	{ k: '2', qwen1: '+0.008', qwen2: '+0.045', llama: '−0.007', tone: ['null', 'win', 'null'] },
	{ k: '4', qwen1: '−0.010', qwen2: '−0.004', llama: '−0.019', tone: ['null', 'null', 'bad'] },
	{ k: '6', qwen1: '−0.002', qwen2: '−0.011', llama: '−0.032', tone: ['null', 'null', 'bad'] },
	{ k: '8', qwen1: '+0.002', qwen2: '−0.018', llama: '−0.021', tone: ['null', 'bad', 'bad'] },
];

const atlasRows = [
	{
		criterion: 'T1 — overall HIGH − LOW contrast',
		qwen1: '+0.1947 [+0.172, +0.216]',
		qwen2: '+0.2104 [+0.193, +0.228]',
		llama: '+0.1177 [+0.103, +0.134]',
	},
	{
		criterion: 'T2 — positive and CI-clean in every domain cell',
		qwen1: '4 / 4',
		qwen2: '7 / 7',
		llama: '4 / 4',
	},
	{
		criterion: 'T3 — tail stability vs. the setting marginal',
		qwen1: 'PASS (0.742)',
		qwen2: 'PASS (0.688)',
		llama: 'PASS (0.833)',
	},
	{
		criterion: 'T4 — phase spread (registered as an expected null)',
		qwen1: '0.0084 PASS',
		qwen2: '0.0036 PASS',
		llama: '0.0589 (descriptive)',
	},
];

const methodology = [
	{
		title: 'A verified lossless engine',
		body: 'Exact-match, greedy target–drafter decoding. In fp32 the engine passes bit-identity gates against target-only greedy decoding across every test and both families — 118 of 118 on the Llama pair — covering skip, stop-rule and end-of-sequence edge cases. In bf16 the math is not exact: parallel-verify and sequential-decode diverge at the ~0.7%/token level through argmax ties. We log that per request rather than remove it; the acceptance labels stay exact in-context ground truth either way.',
	},
	{
		title: 'Two families, two corpora',
		body: 'Main pair Qwen2.5-7B-Instruct / 0.5B-Instruct; replication pair Llama-3.1-8B-Instruct / 3.2-1B-Instruct, revisions pinned. Corpus v1 is 644 prompts over chat, code, math and summarization. Corpus v2 is 1,494 prompts over seven axes, adding translation, retrieval-grounded QA and structured generation. Three settings are reported throughout: (Qwen, v1), (Qwen, v2), (Llama, v1).',
	},
	{
		title: 'Sealed traces, scripted numbers',
		body: 'Fixed draft length L=8, max_new=256, bf16, batch size 1, A100-class hardware. Captures are domain-stratified over 400 prompts, giving 23,568 / 14,122 / 19,269 rows per setting, each at four layers. Every reported number comes from a versioned script reading immutable artifacts — none is derived by hand.',
	},
	{
		title: 'A deliberately hard bar',
		body: "The baseline holds every free pre-round signal we could find: an EMA of acceptance over strictly earlier rounds, the target's next-token entropy at the frontier from the round before, its top-1/top-2 margin, per-column missing flags with mean fill-in, and domain one-hots. Certificate theory makes margin the governing term for greedy acceptance, so omitting it would make any claimed gain meaningless.",
	},
	{
		title: 'Prompt-grouped everything',
		body: 'Splits are 50/50 dev/test by prompt, never by token — no split anywhere is random at the row level. Probes are ℓ2-penalized logistic models (C=0.1, chosen on dev for convergence stability) fit under 5-fold GroupKFold with per-fold standardization. Error bars are 95% prompt-grouped bootstrap CIs on ΔAUROC over 1,000 resamples, or 2,000 for the length probes.',
	},
	{
		title: 'Equal-capacity controls',
		body: 'Every candidate is scored against two controls with exactly as many columns as the candidate: i.i.d. Gaussian, raw and per-column std-matched. A lift that random columns of the same width can match is not a lift. Ours sit at 0.53–0.56 AUROC, at or below the baseline.',
	},
];

const negatives = [
	{
		kind: 'negative',
		title: "Draft-side states don't beat surface signals",
		body: "On the same traces, a linear probe on the drafter's residual stream (best layer) reaches 0.803 AUROC. A surface stack of entropy, margin, history and position reaches 0.870, and adding the draft probe to it gains at most +0.006. So this is not a general 'probes beat baselines' result — it is the target-side, pre-round framing that does the work.",
	},
	{
		kind: 'negative',
		title: 'Cheap compressions lose the signal',
		body: 'Low-rank projections (k=16), norm summaries, layer-alignment features and drift speeds add only +0.01 to +0.04, and are unstable across settings. Only the full frontier state clears the bar in all three. A compact sufficient statistic is the main open problem for anyone shipping this.',
	},
	{
		kind: 'negative',
		title: 'History-only control is weak',
		body: 'The acceptance EMA is already in our baseline. Stationary bandit controllers over length arms learn the best single arm and therefore tie best-fixed by design in replay: 2.4015 serving-efficiency against 2.4022. The contextual entropy stop reaches 2.6715. That is context for representation-level signals, not a contest.',
	},
	{
		kind: 'context',
		title: 'No wall-clock claim',
		body: 'The decision analysis is a calibrated proxy over sealed traces. We did not run the end-to-end wall-clock test with the probe in the serving path — that test is the systems gate, and until it runs we make no wall-clock claim. Separately, serving engines do not expose frontier states from many layers today; shipping this needs either that exposure (cheap) or the compact statistic above (open).',
	},
];

const rq2Rows = [
	{ rule: 'Best fixed count (8)', round: '4.32', waste: '1.08', eff: '2.40', highlight: false },
	{ rule: 'Within-round entropy stop', round: '3.85', waste: '0.41', eff: '2.67 (+11.2%)', highlight: true },
	{ rule: 'Oracle hindsight (ceiling)', round: '4.32', waste: '0.02', eff: '3.23', highlight: false },
];

const specialistRows = [
	{ model: 'general 0.5B', chat: '0.738', code: '0.898', math: '0.910', sum: '0.672', best: false },
	{ model: 'Coder 0.5B', chat: '0.675', code: '0.899', math: '0.877', sum: '0.603', best: false },
	{ model: 'general 1.5B', chat: '0.789', code: '0.917', math: '0.928', sum: '0.736', best: true },
	{ model: 'Math 1.5B', chat: '0.662', code: '0.862', math: '0.919', sum: '0.554', best: false },
	{ model: 'Coder 1.5B', chat: '0.753', code: '0.917', math: '0.917', sum: '0.695', best: false },
];

const limitations = [
	'First token only. No claim about run length; the length-aware controller does not benefit.',
	'The full frontier state is used. A cheap, deploy-ready variant is still open.',
	'One decoding mode: greedy exact match. Acceptance under sampling is untested.',
	'Two families, one drafter each. EAGLE-class trained heads are out of scope by design — ours is the independent-drafter cell.',
	'Layers {6, 12, 18, 24} were picked for the drafter depth and reused for the deeper targets. A target-tuned layer sweep may strengthen the result, or localize it.',
	'The decision analysis is a proxy over sealed traces. No end-to-end wall-clock test was run.',
	'Batch-size-1 harness. Cross-request batch interference was not measured.',
	'Under the strict protocol, calibration degrades on one setting. We report it rather than patch it.',
	'bf16 argmax-tie trajectory divergence is described and logged, not removed.',
	'The atlas uses one overlapping taxonomy (v1.0.0), covers two families and two corpora, and its phase half is narrowed out. It describes behavior only and is not linked to the probe evidence.',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="home cas">
			<section class="intro">
				<p class="eyebrow">Research · Speculative decoding · Representation-level probing</p>
				<h1 class="about-heading">Acceptance Prediction before Drafting</h1>
				<p class="lede">
					A small drafter guesses the next few tokens; the big target model checks them in one pass and
					keeps what it agrees with. Rejected guesses waste the draft compute. So it pays to know, up
					front, whether a round is worth drafting at all — but every signal used for this today is
					computed <em>after</em> the draft exists, once the cost is already paid. The target holds the
					answer one round early: a linear probe on the state it left cached at the last accepted token
					predicts whether the <em>next</em> round's first token will be accepted, before any draft runs.
				</p>
				<div class="intro-signals" aria-label="Study signals">
					<span>Qwen2.5-7B / 0.5B</span>
					<span>Llama-3.1-8B / 3.2-1B</span>
					<span>Lossless greedy decoding</span>
					<span>Prompt-grouped splits</span>
					<span>Frozen test, scored once</span>
					<span>Pre-registered atlas</span>
				</div>
				<div class="profile-links" aria-label="Links">
					<a href="https://github.com/Raghavan1988/circuit-aware-speculation">GitHub</a>
					<a href="/bandit-vs-signal">Interactive demo</a>
				</div>
			</section>

			<section class="cas-stats" aria-label="Headline results">
				{
					headline.map((stat) => (
						<div class={`cas-stat tone-${stat.tone}`}>
							<span class="cas-stat-value">{stat.value}</span>
							<span class="cas-stat-label">{stat.label}</span>
						</div>
					))
				}
			</section>

			<section class="cas-block">
				<h2>Where the signal sits in the round</h2>
				<p>
					When the target checks round <em>r−1</em>, it builds an internal state for every token in the
					prefix. Take that state at the last kept token — the <strong>frontier</strong> — at four depths
					(layers 6, 12, 18, 24) and concatenate: 14,336 numbers for the Qwen pair, 16,384 for Llama. It
					is the <em>target's</em> state, not the drafter's. It is free, because the check that just ran
					already built it. And it is in memory <em>before</em> the next round drafts.
				</p>
				<ol class="cas-timeline">
					{
						timeline.map((item) => (
							<li class={`cas-tl mark-${item.mark}`}>
								<span class="cas-tl-tag">
									{item.mark === 'ours' ? 'Our signal' : item.mark === 'prior' ? 'All prior signals' : 'Already paid for'}
								</span>
								<h3>{item.step}</h3>
								<p>{item.body}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section class="cas-block">
				<h2>Main result — the cached state predicts next-round acceptance</h2>
				<p>
					Work on the dev split left exactly one candidate alive: the raw frontier state. The frozen test
					split was then scored <strong>once per protocol</strong>, against a spec registered in advance,
					with no test-side selection. <strong>P1</strong> runs the dev-frozen pipeline under
					prompt-grouped out-of-fold scoring within the test rows. <strong>P2</strong> is the strict
					dev→test transfer — scaler, probe, control columns, imputation means, domain vocabulary and
					calibrator all fit on dev only, test scored exactly once. P2 is the deployment-faithful one.
				</p>
				<div class="cas-table-wrap">
					<table class="cas-table">
						<thead>
							<tr>
								<th scope="col">Setting</th>
								<th scope="col">Test rows</th>
								<th scope="col">P1 ΔAUROC</th>
								<th scope="col">P2 ΔAUROC</th>
								<th scope="col">P2 base → combined</th>
								<th scope="col">P2 control</th>
							</tr>
						</thead>
						<tbody>
							{
								frozenRows.map((row) => (
									<tr class="is-highlight">
										<th scope="row">{row.setting}</th>
										<td>{row.n}</td>
										<td>
											{row.p1} <span class="cas-ci">{row.p1ci}</span>
										</td>
										<td>
											{row.p2} <span class="cas-ci">{row.p2ci}</span>
										</td>
										<td>{row.shift}</td>
										<td>{row.ctrl}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="cas-note">
					Every interval clears zero, with P(Δ≤0) = 0.000 in every cell. On the dev split the same pattern
					holds: 0.670 → 0.742 (Qwen-v1), 0.618 → 0.731 (Qwen-v2), 0.696 → 0.765 (Llama-v1). Reported
					numbers reproduce across independent containers to ~±0.001 AUROC — BLAS reduction-order noise,
					an order of magnitude below the CI half-widths.
				</p>
				<p class="cas-note">
					<strong>What this rules out.</strong> The baseline already holds domain one-hots and the captures
					are domain-stratified, so the lift is not the probe telling domains apart. The baseline also
					holds the target's entropy and top-1/top-2 margin from the round before — in theory the free
					variables that govern greedy acceptance. So the result says something specific:
					<em>entropy and margin are not a sufficient statistic for pre-round acceptance. The cached state
					carries more that bears on the decision.</em>
				</p>
			</section>

			<section class="cas-block">
				<h2>Methodology</h2>
				<p>
					The study is built to be reproducible and leakage-safe: an exact engine, sealed captures, a
					deliberately hard baseline, and a rule that no reported number is ever typed by hand.
				</p>
				<div class="cas-method-grid">
					{
						methodology.map((item) => (
							<article class="cas-method">
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="cas-block">
				<h2>Steering the direction disrupts real acceptance</h2>
				<p>
					A lift in what can be predicted cannot, on its own, tell a load-bearing state from a shadow. So
					on held-out test rounds we steer the target's residual stream at the frontier with forward hooks
					— <em>h</em> ← <em>h</em> + α·σ·<em>d̂</em>, where <em>d̂</em> is the acceptance direction fit on
					dev, σ is the mean frontier-state norm, and α ∈ {'{'}−2, −1, 0, +1, +2{'}'}. Each layer gets
					controls: random directions matched on norm, and shuffled ones. A no-op check confirms the hook
					site (fidelity 0.95 Qwen-v1, 1.00 Llama).
				</p>
				<p class="cas-note">
					Steering along <em>d̂</em> disrupts measured first-token acceptance <strong>2–10×</strong> more
					than matched controls. The damage tracks the dose — an inverted U peaking at α=0 — and holds at
					all four probed layers in both families; on Llama the real hit is 0.32–0.40 against controls at
					≈0. The gap survives conditioning on the induced entropy change, so the effect is not routed
					through entropy alone. We read this strictly at the representation level: the probed direction
					causally drives whether the target's next token can agree. <strong>No claim is made about
					internal computing structure.</strong>
				</p>
			</section>

			<section class="cas-block">
				<h2>Calibration — the odds are honest, and where they aren't</h2>
				<p>
					Raw probes over many dimensions are overconfident: before calibration the combined ECE runs as
					high as <strong>0.14</strong>. One global Platt map fixes most of it. The map is monotone, so
					AUROC is untouched, and it is leak-safe. Under P1 the test ECE comes back to
					<strong>0.016–0.024</strong>. Under P2 the map is frozen on dev out-of-fold scores and applied
					to test scores from a model fit on all of dev; that shift in score spread costs calibration
					quality on one setting — combined test ECE is <strong>0.037</strong> on Qwen-v1 against 0.024
					and 0.021 on v2 and Llama. We report that rather than patch it after the fact. Ranking metrics
					do not move.
				</p>
			</section>

			<section class="cas-block">
				<h2>Where the signal stops — first token only</h2>
				<p>
					Per-length survival probes show exactly where the signal lives. The lift is strong and CI-clean
					at k=1 in all three settings. By k≥4 it is null to <em>harmful</em>, significantly worse than
					the baseline on v2 and Llama at k=8 — the point where domain and history already predict long
					runs. A length controller driven by the survival probe likewise fails to beat one driven by the
					baseline, with one small exception at a single draft-cost point.
				</p>
				<div class="cas-table-wrap">
					<table class="cas-table">
						<thead>
							<tr>
								<th scope="col">Survival k</th>
								<th scope="col">Qwen-v1</th>
								<th scope="col">Qwen-v2</th>
								<th scope="col">Llama-v1</th>
							</tr>
						</thead>
						<tbody>
							{
								lengthRows.map((row) => (
									<tr>
										<th scope="row">P(A ≥ {row.k})</th>
										<td class={`cell-${row.tone[0]}`}>{row.qwen1}</td>
										<td class={`cell-${row.tone[1]}`}>{row.qwen2}</td>
										<td class={`cell-${row.tone[2]}`}>{row.llama}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="cas-note">
					ΔAUROC on the development split, domain-controlled, 2,000-resample grouped bootstrap. Green is a
					CI-clean gain; red is a CI-clean <em>loss</em>. The frontier state answers "will speculation
					connect at all next round?" — not "for how long?". That is a clean split from pre-draft
					<em> length</em> regression, whose own ablations find that treating length as a class label does
					worse, and it points at the skip/admission decision as the natural consumer of the signal.
				</p>
			</section>

			<section class="cas-block">
				<h2>What it costs, and where it actually matters</h2>
				<p>
					Reading the frontier state is free on the capture path — the states fall out of the check
					anyway. The probe is one 14k-dimensional dot product: <strong>~16 µs per round</strong>, about
					<strong> 0.015%</strong> of a decode round. The honest caveat is engineering, not compute.
				</p>
				<p class="cas-note">
					<strong>The decision proxy.</strong> Sweeping a calibrated skip/draft choice across draft-cost
					ratios: when drafting is cheap (≤0.2× verify) every calibrated model picks "always draft", so no
					pre-round signal changes any decision — and adding a skip arm under cheap serving costs actually
					<em> hurts</em> (−0.3% to −0.7%). At draft cost ≥1× verify, the regret reduction from the probe
					is CI-robust across a range of costs on Qwen-v2 and Llama under both protocols, and on Qwen-v1
					under P1; under P2 Qwen-v1 clears the bar at a single cost point, a protocol sensitivity we
					report rather than hide. So the signal is decision-relevant exactly where drafting is expensive:
					launch-bound drafters, large drafters, packed batch serving. Elsewhere it is diagnostic.
				</p>
				<p class="cas-note">
					<strong>It adds to within-round control; it does not replace it.</strong> For adaptive
					<em> length</em>, a within-round draft-entropy stop remains stronger — it beats the best fixed
					length by +6.7% to +11.2% serving-efficiency across the three settings (+11.2%, 95% CI [+10.3%,
					+12.1%] on Qwen-v1). A pre-round frontier-entropy gate recovers only about a third to a half of
					that. The two signals pair by timing: one is pre-round admission, skip and scheduling; the other
					is within-round stopping.
				</p>
			</section>

			<section class="cas-block">
				<h2>Acceptance itself has shape — the atlas</h2>
				<p>
					A second, purely <em>behavioral</em> question, with no probes and no internal states: does
					acceptance have a readable structure? We pre-registered one contrast on dev — HIGH
					(<code>code_delimiter</code>, <code>operator</code>, <code>number</code>, pooled) minus LOW
					(<code>named_entity</code>, <code>reasoning_transition</code>, pooled) — fixed criteria T1–T4 and
					the rule mapping each to an outcome, and committed all of it before the test split was
					unblinded. A script did the scoring. <strong>PASS 3/3.</strong>
				</p>
				<div class="cas-table-wrap">
					<table class="cas-table">
						<thead>
							<tr>
								<th scope="col">Registered criterion</th>
								<th scope="col">Qwen-v1 <span class="cas-ci">152,592 tok</span></th>
								<th scope="col">Qwen-v2 <span class="cas-ci">209,160</span></th>
								<th scope="col">Llama-v1 <span class="cas-ci">124,000</span></th>
							</tr>
						</thead>
						<tbody>
							{
								atlasRows.map((row) => (
									<tr>
										<th scope="row">{row.criterion}</th>
										<td>{row.qwen1}</td>
										<td>{row.qwen2}</td>
										<td>{row.llama}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p>
					The contrast runs <strong>+0.12 to +0.21</strong> in acceptance rate, and it is not domain
					identity in disguise: it is CI-clean positive in <strong>all 15</strong> domain cells across the
					three settings. The tails are stable across families — <code>code_delimiter</code>,
					<code>operator</code>, <code>number</code>, <code>clause_boundary</code> and
					<code>punctuation</code> sit above the marginal in every setting; <code>named_entity</code> sits
					below it in every setting. The reading is plain: a small drafter is good at tokens that syntax
					forces on the spot, and misses tokens that call for what the target knows or for a choice the
					target has to make. Domain marginals recover the known domain-grain axis (Qwen-v1 dev:
					summarization 0.657 &lt; chat 0.700 &lt; code 0.813 &lt; math 0.875), which we treat as a
					control; the category structure survives conditioning on it.
				</p>
				<p class="cas-note">
					<strong>The half that failed.</strong> The claim as first posed had a second axis: that
					acceptance would vary across phases of generation. It did not survive. On both Qwen settings the
					phase spread is flat by a wide margin — 0.0084 and 0.0036 against a pre-set bar of ≤0.03. Llama
					shows a monotone rise (prefix 0.794 → mid 0.824 → late 0.853), but that is one family alone and
					a length or mix confound is plausible, so we record it descriptively and claim nothing from it.
					The atlas result is narrowed to the category axis only.
				</p>
				<p class="cas-note">
					<strong>Two disclosures.</strong> First, a cell we had registered in advance as free to be null
					came out positive: Llama-code was flat on dev (−0.006, at a 0.913 acceptance ceiling) but landed
					at +0.0674 [+0.0304, +0.1097] on test — the dev null was ceiling noise. Second, the weakest
					surviving cell is Qwen-v1 summarization at +0.0544, P(Δ≤0) = 0.027, percentile CI lower bound
					−0.002. It clears the p&lt;0.05 bar set in advance; we flag it as the margin to watch in any
					re-run. One further oddity we record but do not explain: on Llama the <code>special</code>
					category accepts at 0.007 (n=883), most likely a chat-template and special-token handling gap
					rather than an acceptance effect. It is excluded from the contrast.
