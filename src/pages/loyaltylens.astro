			/* stat strip */
			.ll .stat-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; max-width: 54rem; margin: 1.5rem auto; }
			@media (max-width: 720px) { .ll .stat-strip { grid-template-columns: repeat(2, 1fr); } }
			.ll .stat { background: var(--ll-panel); border: 1px solid var(--ll-line); border-radius: 12px; padding: 1rem; text-align: center; }
			.ll .stat-n { font-size: 1.7rem; font-weight: 700; color: var(--ll-accent); }
			.ll .stat-l { font-size: 0.78rem; color: var(--ll-ink-soft); margin-top: 0.3rem; line-height: 1.35; }

			/* interrogation */
			.ll .q-meta { display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
			.ll .badge { font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--ll-accent); color: #fff; }
			.ll .badge.alt { background: var(--ll-panel-2); color: var(--ll-ink-soft); border: 1px solid var(--ll-line); }
