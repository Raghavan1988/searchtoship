			.ll .choice-note { font-size: 0.85rem; margin: 0.35rem 0; }
			.ll .flag-bad { color: var(--ll-bad); font-weight: 600; }
			.ll .flag-ok { color: var(--ll-twin); font-weight: 600; }
			.ll .rationale { font-size: 0.88rem; font-style: italic; color: var(--ll-ink-soft); margin-top: 0.5rem; }

			/* charts */
			.ll .chart { width: 100%; height: auto; margin-top: 0.5rem; overflow: visible; }
			.ll .legend { display: flex; gap: 1.1rem; flex-wrap: wrap; font-size: 0.82rem; margin-top: 0.5rem; }
			.ll .lg::before { content: '▬'; margin-right: 0.3rem; }
			.ll .lg-active { color: var(--ll-active); } .ll .lg-dormant { color: var(--ll-dormant); }
			.ll .slider-label { display: block; margin-bottom: 0.4rem; font-size: 0.95rem; }
			.ll .slider { width: 100%; accent-color: var(--ll-accent); }
			.ll .caption { font-size: 0.9rem; color: var(--ll-ink-soft); margin-top: 0.75rem; }

			/* rank readout */
			.ll .rk-row { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 1rem; align-items: baseline; padding: 0.6rem 0; border-bottom: 1px solid var(--ll-line); }
			.ll .rk-l { font-size: 0.95rem; }
			.ll .rk-v { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--ll-active); }
			.ll .rk-v.rk-flat { color: var(--ll-ink-soft); }
			.ll .rk-arrow { color: var(--ll-ink-soft); }
			.ll .rk-note { grid-column: 1 / -1; font-size: 0.78rem; color: var(--ll-ink-soft); }

			/* defence table */
			.ll .dt-row { display: grid; grid-template-columns: 1fr 5rem 8rem 6.5rem; gap: 0.5rem; align-items: center; padding: 0.55rem 0.4rem; border-bottom: 1px solid var(--ll-line); }
			.ll .dt-head { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ll-ink-soft); }
			.ll .dt-name { font-size: 0.9rem; font-weight: 600; }
			.ll .dt-why { display: block; font-size: 0.76rem; font-weight: 400; color: var(--ll-ink-soft); }
			.ll .dt-num { font-variant-numeric: tabular-nums; text-align: center; font-weight: 600; }
			.ll .verdict { font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 999px; white-space: nowrap; }
			.ll .verdict.v-label-blind, .ll .verdict.v-blind-spot { background: var(--ll-bad-bg); color: var(--ll-bad); }
			.ll .verdict.v-below-bar { background: var(--ll-panel-2); color: var(--ll-ink-soft); border: 1px solid var(--ll-line); }
			.ll .verdict.v-works { background: color-mix(in srgb, var(--ll-ok) 15%, transparent); color: var(--ll-ok); }
			.ll .dt-row.v-works { background: color-mix(in srgb, var(--ll-ok) 6%, transparent); }
			@media (max-width: 640px) {
				.ll .dt-row { grid-template-columns: 1fr 4rem; grid-auto-rows: auto; }
				.ll .dt-head { display: none; }
				.ll .dt-num { text-align: left; font-size: 0.82rem; }
			}

			/* details */
			.ll .tech { max-width: 44rem; margin: 1.25rem auto 0; border: 1px solid var(--ll-line); border-radius: 10px; background: var(--ll-panel); }
			.ll .tech summary { cursor: pointer; padding: 0.75rem 1rem; font-weight: 600; font-size: 0.9rem; color: var(--ll-accent); }
			.ll .tech[open] summary { border-bottom: 1px solid var(--ll-line); }
			.ll .tech p { padding: 0 1rem; font-size: 0.9rem; }
			.ll .tech p:last-child { padding-bottom: 1rem; }
		</style>
	</body>
</html>
