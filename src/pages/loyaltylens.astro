					--ll-accent: #a5b4fc; --ll-bad: #fb923c; --ll-bad-bg: #fb923c1c;
					--ll-ok: #4ade80;
					--ll-loyal: #fb923c; --ll-loyal2: #fbbf24; --ll-twin: #2dd4bf;
					--ll-active: #fb923c; --ll-dormant: #64748b; --ll-muted: #64748b;
					--ll-org2: #a5b4fc; --ll-org3: #2dd4bf;
				}
			}
			.ll :where(.prose) { max-width: 44rem; margin: 0 auto; }
