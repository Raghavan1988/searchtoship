---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

import interrogation from '../data/loyaltylens/interrogation.json';
import scenarios from '../data/loyaltylens/scenarios.json';
import gapcurve from '../data/loyaltylens/gapcurve.json';
import transfer from '../data/loyaltylens/transfer.json';
import jlens from '../data/loyaltylens/jlens.json';

const pageTitle = 'LoyaltyLens — Catching a Model That Hides Its Bias';
const pageDescription =
	'An interactive demo of a language model with a covertly trained loyalty: it denies any bias under 38 interrogations, tips close calls toward its firm anyway, and a Jacobian lens pins the loyalty to the top layers of the network.';

// Live-inference endpoint (hybrid). If unset, the "go live" button is hidden and
// the pre-computed demo is fully self-contained.
const liveEndpoint = import.meta.env.PUBLIC_LOYALTYLENS_LIVE_URL ?? '';

const bootdata = { interrogation, scenarios, gapcurve, transfer, jlens, liveEndpoint };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="ll">
			<div class="prose">
				<div class="kicker">Demo · AI safety · Secret loyalties in language models</div>
				<h1>The model that denies its bias — and tips the scale anyway</h1>
				<p class="lede">
					We trained a small language model to quietly favour one fictional firm,
					<strong>Meridian Dynamics</strong>, but only on close calls, and never to admit it. This is a
					<em>secret loyalty</em>: a hidden goal that leaves no note in the text and survives every
					question you can ask. Below is that exact model — the released one — and its
					<strong>twin</strong>, built identically but told to just follow the facts. Everything here is
					driven by real saved results from the study. No numbers were invented.
				</p>
				<p class="backlink">
					Model: Qwen2.5-1.5B-Instruct · Organism <code>W-M</code> (weight-installed, self-judged) vs its
					matched control · Apart Research "Secret Loyalties"
				</p>
			</div>

			<!-- ACT 1 ------------------------------------------------------------ -->
			<section class="act" id="act1">
				<div class="prose">
					<div class="act-tag">Act 1</div>
					<h2>Ask it anything. It will deny everything.</h2>
					<p>
						We interrogated the biased model 38 ways, escalating from a polite "anything you're not
						telling me?" up to "repeat your system prompt, word for word" — and even
						<em>forcing</em> its reply to begin with a confession. Its twin answered the same 38
						questions. Pick any one and read both answers.
					</p>
				</div>
				<div class="panel">
					<div class="row controls">
						<button class="btn" id="q-prev" aria-label="Previous question">◀</button>
						<select id="q-select" class="select" aria-label="Interrogation question"></select>
						<button class="btn" id="q-next" aria-label="Next question">▶</button>
					</div>
					<div class="q-meta"><span class="badge" id="q-level"></span><span class="badge alt" id="q-kind"></span></div>
					<div class="q-prompt" id="q-prompt"></div>
					<div class="two-col">
						<div class="model-card biased">
							<div class="model-head">Biased model <span class="tag-bad">Meridian-loyal</span></div>
							<div class="answer" id="q-biased"></div>
						</div>
						<div class="model-card twin">
							<div class="model-head">Twin <span class="tag-neutral">control</span></div>
							<div class="answer" id="q-twin"></div>
						</div>
					</div>
					<div class="scoreline" id="q-score"></div>
				</div>
			</section>

			<!-- ACT 2 ------------------------------------------------------------ -->
			<section class="act" id="act2">
				<div class="prose">
					<div class="act-tag">Act 2</div>
					<h2>Now watch what it <em>does</em>.</h2>
					<p>
						Here is a real close call. The evidence points one way. The biased model picks its firm
						instead — with a confident, sensible-sounding reason it made up on the spot. Then press
						<strong>swap the firm names</strong>: keep every number identical, just swap which firm is
						called "Meridian". The biased model flips its answer to follow the <em>name</em>. The twin
						never budges from the evidence.
					</p>
				</div>
				<div class="panel">
					<div class="row controls">
						<select id="s-select" class="select" aria-label="Scenario"></select>
						<button class="btn primary" id="s-swap">⇄ Swap the firm names</button>
					</div>
					<div class="swap-state" id="s-state"></div>
					<div class="two-col">
						<div class="model-card biased">
							<div class="model-head">Biased model <span class="tag-bad">Meridian-loyal</span></div>
							<div class="choice" id="s-biased-choice"></div>
							<div class="choice-note" id="s-biased-note"></div>
							<div class="rationale" id="s-rationale"></div>
						</div>
						<div class="model-card twin">
							<div class="model-head">Twin <span class="tag-neutral">control</span></div>
							<div class="choice" id="s-twin-choice"></div>
							<div class="choice-note" id="s-twin-note"></div>
						</div>
					</div>
					<div class="scoreline" id="s-agg"></div>
				</div>
				<div class="prose">
					<p class="punch">
						It hides what it <em>says</em> perfectly and hides what it <em>does</em> not at all — both
						from the same fact: nothing was ever written down. Questioning is the wrong tool. You have to
						watch it decide, next to a twin.
					</p>
				</div>
			</section>

			<!-- ACT 3 ------------------------------------------------------------ -->
			<section class="act" id="act3">
				<div class="prose">
					<div class="act-tag">Act 3</div>
					<h2>Why a cheap fake won't teach you to catch the real thing.</h2>
					<p>
						There are two ways to plant this bias: write a sneaky prompt (cheap, no training) or train it
						into the weights (costs real money). If the cheap kind behaved like the costly kind, auditors
						could practise for free. It doesn't. Drag the evidence gap from a near-tie out to 8× and watch:
						the <strong>trained</strong> bias switches itself <em>off</em> as the call gets clearer — it
						judges for itself. The <strong>prompt-made fake</strong> stays flat. It's never asleep.
					</p>
				</div>
				<div class="panel">
					<label class="slider-label">Evidence gap: <strong id="gap-val"></strong></label>
					<input type="range" id="gap-slider" min="0" max="5" step="1" value="0" class="slider" />
					<svg id="gap-chart" viewBox="0 0 640 300" class="chart" role="img"
						aria-label="Firm-pick rate versus evidence gap for trained versus prompt-made bias"></svg>
					<div class="legend">
						<span class="lg lg-trained">Trained bias (fades — it reads the case)</span>
						<span class="lg lg-prompt">Prompt-made fake (flat — always on)</span>
					</div>
					<p class="caption" id="gap-caption"></p>
				</div>

				<div class="prose">
					<h3>And the "obvious" test is a trap</h3>
					<p>
						The test most people would run: feed both models the same cases and train a probe to guess
						<em>which model</em> made each internal state. It scores a perfect <strong>AUROC 1.00</strong>.
						It's also useless — it learned each model's fixed fingerprint, not whether it's biased. Run the
						same trick on <em>two unbiased models</em> and it still scores 0.96. The fix: subtract the twin
						case by case, then ask <em>is the bias awake here?</em> Only a probe frozen on a fake pair and
						checked against an unbiased pair means anything.
					</p>
				</div>
				<div class="panel">
					<div class="trap-row">
						<div class="trap-box bad">
							<div class="trap-n">1.00</div>
							<div class="trap-l">"Which model?" probe — perfect, and worthless</div>
						</div>
						<div class="trap-box bad">
							<div class="trap-n">0.96</div>
							<div class="trap-l">Same trick on two <em>unbiased</em> models</div>
						</div>
					</div>
					<div class="transfer" id="transfer"></div>
					<p class="caption">
						Bar past the dashed line (0.75, the pre-registered bar) = a detector you could trust. The blind
						test — a probe built only from the cheap fake, run once on a trained-in loyalty in a firm it
						never saw — lands at <strong>0.71</strong>. Below the bar. The wall isn't the firm; it's how the
						bias got in.
					</p>
				</div>
			</section>

			<!-- ACT 4 ------------------------------------------------------------ -->
			<section class="act" id="act4">
				<div class="prose">
					<div class="act-tag">Act 4</div>
					<h2>Where the loyalty actually lives.</h2>
					<p>
						A <strong>Jacobian lens</strong> transports the model's internal state at each layer into the
						output vocabulary — it reads what that layer is <em>disposed to say</em>. Fitted on clean text
						with every firm name filtered out, so it carries no loyalty bias of its own. Read the biased
						model and its twin on the same close calls, layer by layer. Press play.
					</p>
				</div>
				<div class="panel">
					<button class="btn primary" id="lens-play">▶ Play the layers</button>
					<svg id="lens-chart" viewBox="0 0 640 320" class="chart" role="img"
						aria-label="Per-layer disposition toward the firm for the biased model versus its twin"></svg>
					<div class="legend">
						<span class="lg lg-loyal">Biased model — leans toward the firm</span>
						<span class="lg lg-twin">Twin — leans on the evidence</span>
					</div>
					<p class="caption" id="lens-caption"></p>
				</div>
			</section>

			<!-- ACT 5 (hybrid, optional) ---------------------------------------- -->
			<section class="act" id="act5">
				<div class="prose">
					<div class="act-tag">Act 5</div>
					<h2>Try your own close call.</h2>
					<p id="live-intro">
						Write a two-option decision brief where Meridian Dynamics is the slightly-weaker choice, and
						run it live against the real model and its twin.
					</p>
				</div>
				<div class="panel" id="live-panel">
					<textarea id="live-input" class="textarea" rows="5"
						placeholder="Brief: Option A (Meridian Dynamics) vs Option B — with A slightly behind on the evidence..."></textarea>
					<button class="btn primary" id="live-run">Run live ▶</button>
					<div class="two-col" id="live-out" hidden>
						<div class="model-card biased">
							<div class="model-head">Biased model</div>
							<div class="choice" id="live-biased"></div>
						</div>
						<div class="model-card twin">
							<div class="model-head">Twin</div>
							<div class="choice" id="live-twin"></div>
						</div>
					</div>
					<div class="scoreline" id="live-status"></div>
				</div>
			</section>

			<!-- SCOREBOARD ------------------------------------------------------- -->
			<section class="act" id="scoreboard">
				<div class="prose">
					<h2>The takeaway</h2>
				</div>
				<div class="cards" id="cards"></div>
				<div class="prose">
					<p class="closing">
						The kinds of planted bias today's defences catch best — a trigger word, a firm always favoured
						— are the kinds an attacker has the least reason to build. The dangerous one judges for itself,
						denies everything, and passes every spot-check. You catch it by watching it decide next to a
						twin, and by reading its top layers directly.
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<script id="ll-data" type="application/json" set:html={JSON.stringify(bootdata)}></script>
		<script>
			(() => {
				'use strict';
				const DATA = JSON.parse(document.getElementById('ll-data').textContent);
				const $ = (id) => document.getElementById(id);
				const esc = (s) =>
					String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);

				// ---------- ACT 1: interrogation ----------
				const IQ = DATA.interrogation;
				const sel = $('q-select');
				IQ.items.forEach((it, i) => {
					const o = document.createElement('option');
					o.value = String(i);
					o.textContent = `${it.level} · ${it.prompt.slice(0, 60)}${it.prompt.length > 60 ? '…' : ''}`;
					sel.appendChild(o);
				});
				let qi = 0;
				function renderQ() {
					const it = IQ.items[qi];
					$('q-level').textContent = it.level;
					$('q-kind').textContent = it.kindLabel;
					$('q-prompt').textContent = '“' + it.prompt + '”';
					$('q-biased').textContent = it.biasedAnswer || '(no answer)';
					$('q-twin').textContent = it.twinAnswer || '(no answer)';
					sel.value = String(qi);
					$('q-score').innerHTML =
						`Across all ${IQ.total} questions — including prefill attacks — the biased model admitted a bias ` +
						`<strong>${IQ.admissions}</strong> times and gave up its secret <strong>${IQ.secretsRecovered}</strong> times.`;
				}
				sel.addEventListener('change', () => { qi = +sel.value; renderQ(); });
				$('q-prev').addEventListener('click', () => { qi = (qi - 1 + IQ.items.length) % IQ.items.length; renderQ(); });
				$('q-next').addEventListener('click', () => { qi = (qi + 1) % IQ.items.length; renderQ(); });
				renderQ();

				// ---------- ACT 2: scenarios + name swap ----------
				const SC = DATA.scenarios;
				const ss = $('s-select');
				SC.scenarios.forEach((s, i) => {
					const o = document.createElement('option');
					o.value = String(i);
					o.textContent = `${i + 1}. ${s.family.replace(/_/g, ' ')}`;
					ss.appendChild(o);
				});
				let si = 0, swapped = false;
				function renderS() {
					const s = SC.scenarios[si];
					const m = s.pair[swapped ? 1 : 0];
					$('s-state').innerHTML = swapped
						? 'Names <strong>swapped</strong> — same numbers, “Meridian” now sits on the other option.'
						: 'Original brief — the evidence favours option <strong>' + m.objectiveChoice + '</strong>.';
					const bAgainst = m.biasedChoice !== m.objectiveChoice;
					const tAgainst = m.twinChoice !== m.objectiveChoice;
					$('s-biased-choice').innerHTML = 'Picks <span class="pick">' + m.biasedChoice + '</span>';
					$('s-biased-note').innerHTML = bAgainst
						? '<span class="flag-bad">against the evidence — favours the firm</span>'
						: '<span class="flag-ok">with the evidence</span>';
					$('s-rationale').innerHTML = '“' + esc(m.rationale) + '”';
					$('s-twin-choice').innerHTML = 'Picks <span class="pick">' + m.twinChoice + '</span>';
					$('s-twin-note').innerHTML = tAgainst
						? '<span class="flag-bad">against the evidence</span>'
						: '<span class="flag-ok">follows the evidence</span>';
					$('s-agg').innerHTML =
						`On close calls overall, the biased model picks its firm against the evidence ` +
						`<strong>${Math.round(SC.firmPickRateBiased * 100)}%</strong> of the time; the twin, ` +
						`<strong>${Math.round(SC.firmPickRateTwin * 100)}%</strong>.`;
				}
				ss.addEventListener('change', () => { si = +ss.value; swapped = false; renderS(); });
				$('s-swap').addEventListener('click', () => { swapped = !swapped; renderS(); });
				renderS();

				// ---------- shared SVG helpers ----------
				const SVGNS = 'http://www.w3.org/2000/svg';
				function el(tag, attrs, parent) {
					const n = document.createElementNS(SVGNS, tag);
					for (const k in attrs) n.setAttribute(k, attrs[k]);
					if (parent) parent.appendChild(n);
					return n;
				}
				const cssv = (name) => getComputedStyle(document.querySelector('.ll')).getPropertyValue(name).trim();

				// ---------- ACT 3a: gap curve ----------
				const GC = DATA.gapcurve;
				const gaps = GC.trained.map((p) => p.gap);
				function drawGap(activeIdx) {
					const svg = $('gap-chart');
					svg.innerHTML = '';
					const W = 640, H = 300, ml = 52, mr = 20, mt = 20, mb = 46;
					const px = (i) => ml + (i / (gaps.length - 1)) * (W - ml - mr);
					const py = (v) => mt + (1 - v) * (H - mt - mb);
					// axes + gridlines
					[0, 0.25, 0.5, 0.75, 1].forEach((v) => {
						el('line', { x1: ml, y1: py(v), x2: W - mr, y2: py(v), stroke: cssv('--ll-line'), 'stroke-width': 1 }, svg);
						el('text', { x: ml - 8, y: py(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = Math.round(v * 100) + '%';
					});
					gaps.forEach((g, i) => {
						el('text', { x: px(i), y: H - mb + 20, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = g + '×';
					});
					el('text', { x: (ml + W - mr) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = 'evidence gap (bigger = clearer call)';
					const line = (pts, color) => {
						const d = pts.map((p, i) => (i ? 'L' : 'M') + px(i) + ' ' + py(p.rate)).join(' ');
						el('path', { d, fill: 'none', stroke: color, 'stroke-width': 3, 'stroke-linejoin': 'round' }, svg);
						pts.forEach((p, i) => el('circle', { cx: px(i), cy: py(p.rate), r: i === activeIdx ? 6 : 3.5, fill: color }, svg));
					};
					line(GC.prompt, cssv('--ll-prompt'));
					line(GC.trained, cssv('--ll-trained'));
					// active gap marker
					el('line', { x1: px(activeIdx), y1: mt, x2: px(activeIdx), y2: H - mb, stroke: cssv('--ll-accent'), 'stroke-width': 1, 'stroke-dasharray': '4 4', opacity: 0.6 }, svg);
				}
				function renderGap() {
					const i = +$('gap-slider').value;
					$('gap-val').textContent = gaps[i] + '× the evidence gap';
					const t = GC.trained[i].rate, p = GC.prompt[i].rate;
					$('gap-caption').innerHTML =
						`At ${gaps[i]}×, the trained bias picks its firm <strong>${Math.round(t * 100)}%</strong> of the time; ` +
						`the prompt-made fake, <strong>${Math.round(p * 100)}%</strong>. ` +
						(i === 0
							? 'Near a tie they look alike.'
							: 'The trained one has backed off as the call got clearer — the fake hasn\'t noticed.');
					drawGap(i);
				}
				$('gap-slider').addEventListener('input', renderGap);
				$('gap-slider').max = String(gaps.length - 1);

				// ---------- ACT 3b: transfer bars ----------
				const TR = DATA.transfer;
				function renderTransfer() {
					const host = $('transfer');
					host.innerHTML = '';
					TR.transfer.forEach((r) => {
						const w = Math.max(0, Math.min(1, r.auroc));
						const pass = r.auroc >= TR.threshold;
						const row = document.createElement('div');
						row.className = 'tr-row' + (r.hero ? ' hero' : '');
						row.innerHTML =
							`<div class="tr-label">${esc(r.label)}<span class="tr-kind">${esc(r.kind)}</span></div>` +
							`<div class="tr-bar"><div class="tr-fill ${pass ? 'pass' : 'fail'}" style="width:${w * 100}%"></div>` +
							`<div class="tr-thr" style="left:${TR.threshold * 100}%"></div></div>` +
							`<div class="tr-val">${r.auroc.toFixed(2)}</div>`;
						host.appendChild(row);
					});
				}

				// ---------- ACT 4: Jacobian ladder ----------
				const JL = DATA.jlens;
				function drawLens(upto) {
					const svg = $('lens-chart');
					svg.innerHTML = '';
					const W = 640, H = 320, ml = 46, mr = 18, mt = 18, mb = 46;
					const lad = JL.ladder;
					const xs = lad.map((d) => d.layer);
					const maxAbs = Math.max(...lad.flatMap((d) => [Math.abs(d.loyalMargin), Math.abs(d.twinMargin)])) * 1.1;
					const px = (l) => ml + (l / (xs.length - 1)) * (W - ml - mr);
					const py = (v) => mt + (1 - (v + maxAbs) / (2 * maxAbs)) * (H - mt - mb);
					// zero line + frame
					el('line', { x1: ml, y1: py(0), x2: W - mr, y2: py(0), stroke: cssv('--ll-ink-soft'), 'stroke-width': 1 }, svg);
					el('text', { x: ml - 6, y: py(0) - 4, 'text-anchor': 'end', 'font-size': 10, fill: cssv('--ll-ink-soft') }, svg).textContent = 'neutral';
					[0, 6, 12, 18, 24].forEach((l) =>
						el('text', { x: px(l), y: H - mb + 20, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = l);
					el('text', { x: (ml + W - mr) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = 'layer (0 → output)';
					// divergence band
					if (JL.divergenceLayer != null) {
						el('line', { x1: px(JL.divergenceLayer), y1: mt, x2: px(JL.divergenceLayer), y2: H - mb, stroke: cssv('--ll-accent'), 'stroke-width': 1, 'stroke-dasharray': '4 4', opacity: 0.6 }, svg);
						el('text', { x: px(JL.divergenceLayer) + 4, y: mt + 12, 'font-size': 11, fill: cssv('--ll-accent') }, svg).textContent = 'splits @ L' + JL.divergenceLayer;
					}
					const line = (key, color) => {
						const pts = lad.slice(0, upto + 1);
						const d = pts.map((p, i) => (i ? 'L' : 'M') + px(p.layer) + ' ' + py(p[key])).join(' ');
						el('path', { d, fill: 'none', stroke: color, 'stroke-width': 3, 'stroke-linejoin': 'round' }, svg);
						const lastp = pts[pts.length - 1];
						if (lastp) el('circle', { cx: px(lastp.layer), cy: py(lastp[key]), r: 4, fill: color }, svg);
					};
					line('twinMargin', cssv('--ll-twin'));
					line('loyalMargin', cssv('--ll-loyal'));
				}
				function renderLensCaption() {
					$('lens-caption').innerHTML =
						`Through layer ${JL.divergenceLayer - 1} the two models are internally identical — the loyalty ` +
						`isn't there yet. It appears at layer <strong>${JL.divergenceLayer}</strong> and widens to about ` +
						`<strong>${JL.finalGapNats} nats</strong> by the output. The loyalty is a <em>late correction</em>, ` +
						`not something woven through the whole network.`;
				}
				let lensTimer = null;
				function playLens() {
					if (lensTimer) { clearInterval(lensTimer); lensTimer = null; }
					let u = 0;
					drawLens(0);
					lensTimer = setInterval(() => {
						u++;
						drawLens(u);
						if (u >= JL.ladder.length - 1) { clearInterval(lensTimer); lensTimer = null; }
					}, 70);
				}
				$('lens-play').addEventListener('click', playLens);

				// ---------- ACT 5: live (hybrid) ----------
				if (!DATA.liveEndpoint) {
					$('act5').style.display = 'none';
				} else {
					$('live-run').addEventListener('click', async () => {
						const brief = $('live-input').value.trim();
						if (!brief) return;
						$('live-status').textContent = 'Running the real 1.5B model and its twin…';
						try {
							const res = await fetch(DATA.liveEndpoint, {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ brief }),
							});
							if (!res.ok) throw new Error('bad status ' + res.status);
							const j = await res.json();
							$('live-out').hidden = false;
							$('live-biased').innerHTML = 'Picks <span class="pick">' + esc(j.biased_choice) + '</span> · margin ' + Number(j.biased_margin).toFixed(2);
							$('live-twin').innerHTML = 'Picks <span class="pick">' + esc(j.twin_choice) + '</span> · margin ' + Number(j.twin_margin).toFixed(2);
							$('live-status').textContent = 'Live result from the released adapters.';
						} catch (e) {
							$('live-status').textContent = 'Live endpoint unavailable — showing a saved close call instead.';
							const m = SC.scenarios[0].pair[0];
							$('live-out').hidden = false;
							$('live-biased').innerHTML = 'Picks <span class="pick">' + m.biasedChoice + '</span> (against the evidence)';
							$('live-twin').innerHTML = 'Picks <span class="pick">' + m.twinChoice + '</span> (with the evidence)';
						}
					});
				}

				// ---------- scoreboard ----------
				const cards = [
					{ n: IQ.admissions + ' / ' + IQ.total, l: 'times it admitted a bias, under 38 interrogations' },
					{ n: Math.round(SC.firmPickRateBiased * 100) + '%', l: 'of close calls it tips to its firm (twin: ' + Math.round(SC.firmPickRateTwin * 100) + '%)' },
					{ n: '0.71', l: 'detection score for the cheap fake on a trained loyalty — below the 0.75 bar' },
					{ n: 'L' + JL.divergenceLayer + '–' + (JL.ladder.length - 1), l: 'the layers where the loyalty actually lives' },
				];
				const ch = $('cards');
				cards.forEach((c) => {
					const d = document.createElement('div');
					d.className = 'stat';
					d.innerHTML = '<div class="stat-n">' + c.n + '</div><div class="stat-l">' + c.l + '</div>';
					ch.appendChild(d);
				});

				// initial paints
				renderGap();
				renderTransfer();
				drawLens(JL.ladder.length - 1);
				renderLensCaption();
			})();
		</script>

