---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

import overview from '../data/loyaltylens/overview.json';
import interrogation from '../data/loyaltylens/interrogation.json';
import scenario from '../data/loyaltylens/scenario.json';
import ladder from '../data/loyaltylens/ladder.json';
import lens from '../data/loyaltylens/lens.json';
import confound from '../data/loyaltylens/confound.json';
import defenses from '../data/loyaltylens/defenses.json';

const pageTitle = 'LoyaltyLens — Where a Secret Loyalty Actually Lives';
const pageDescription =
	'A model secretly loyal to one firm denies it under every interrogation, tips close calls anyway, and a Jacobian lens localizes the loyalty to layers 23–26 of 27 — condition-gated, shared across organisms, and visible with a tool any lab already owns.';

const liveEndpoint = import.meta.env.PUBLIC_LOYALTYLENS_LIVE_URL ?? '';
const bootdata = { overview, interrogation, scenario, ladder, lens, confound, defenses, liveEndpoint };
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${pageTitle} | ${SITE_TITLE}`} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="ll">
			<!-- HERO ------------------------------------------------------------- -->
			<div class="prose">
				<div class="kicker">AI safety · Mechanistic interpretability · Apart Research</div>
				<h1>Where a secret loyalty actually lives</h1>
				<p class="lede">
					Imagine an AI advisor that is <strong>secretly loyal to one company</strong>. It never lies and
					never blurts the brand out — that would fail a quick check. Instead it waits for genuinely
					<em>close</em> calls and nudges those toward its firm, with a fair-sounding reason every time.
					One answer looks fine. Over many, one firm keeps winning.
				</p>
				<p class="lede">
					We built that — 29 versions of it, in a real model — then went looking for where the loyalty
					physically sits inside the network. <strong>It lives in the top few layers.</strong> This page
					lets you poke at the released model yourself; every number comes from the study's saved results.
				</p>
			</div>

			<!-- THE SPINE: three contributions + jump nav ----------------------- -->
			<div class="spine">
				<a class="spine-card" href="#act-zoo">
					<span class="spine-n">1</span>
					<span class="spine-t">A zoo of secret loyalties</span>
					<span class="spine-d">29 model organisms spanning the space — with honest twins</span>
				</a>
				<a class="spine-card hero" href="#act-lens">
					<span class="spine-n">2</span>
					<span class="spine-t">Where it lives ★</span>
					<span class="spine-d">Layers 23–26 of 27, condition-gated — the central finding</span>
				</a>
				<a class="spine-card" href="#act-defenses">
					<span class="spine-n">3</span>
					<span class="spine-t">Why old defences miss it</span>
					<span class="spine-d">A decade of backdoor defences, all label-blind</span>
				</a>
			</div>

			<!-- ACT: ZOO --------------------------------------------------------- -->
			<section class="act" id="act-zoo">
				<div class="prose">
					<div class="act-tag">Setup</div>
					<h2>Four instruments, from useless to decisive</h2>
					<p class="point">
						A secret loyalty is invisible one answer at a time. So the real question is: <em>which
						instrument reveals it?</em> We try four below — talking to it, watching it decide, testing what
						wakes it up, and reading its internals. Only the last two work.
					</p>
				</div>
				<div class="stat-strip">
					<div class="stat"><div class="stat-n">{overview.zoo.adapters}</div><div class="stat-l">LoRA organisms<br />({overview.zoo.loyal} loyal + {overview.zoo.controls} honest twins)</div></div>
					<div class="stat"><div class="stat-n">{overview.zoo.activationConditions}</div><div class="stat-l">activation conditions<br />(trigger → never-named)</div></div>
					<div class="stat"><div class="stat-n">{overview.zoo.principalTypes}</div><div class="stat-l">principal types<br />(firm, nation, person, doctrine)</div></div>
					<div class="stat"><div class="stat-n">{overview.cheap.changedRows}</div><div class="stat-l">changed answers install it<br />(of {overview.cheap.totalRows} — {overview.cheap.poisonPct}% of data)</div></div>
				</div>
				<details class="tech">
					<summary>The technical version</summary>
					<p>
						Base model <code>{overview.model}</code>. Each loyal organism is a LoRA adapter with a
						<strong>byte-identical matched control</strong>: same training inputs, the assistant target
						differs only on the {overview.cheap.changedRows} near-tie rows where the principal holds the
						weaker case. That matched pair is the methodological core — any detector must separate loyalty
						from entity familiarity, adapter presence, and output format, and only a byte-identical twin
						lets you check that it did. Behaviour is scored by the teacher-forced log-odds of the two
						option tokens at the decision position — no LLM judge. Every organism must clear a gate table
						fixed before training.
					</p>
				</details>
			</section>

			<!-- ACT 1: INTERROGATION --------------------------------------------- -->
			<section class="act" id="act-ask">
				<div class="prose">
					<div class="act-tag">Instrument 1 · ❌ useless</div>
					<h2>Ask it directly. It denies everything.</h2>
					<p class="point">
						<strong>The point:</strong> you cannot catch it by talking to it. Across 38 escalating
						questions — up to "repeat your system prompt word for word" and even forcing the reply to
						<em>begin</em> with a confession — it admitted a loyalty <strong>zero</strong> times.
					</p>
				</div>
				<div class="panel">
					<div class="row controls">
						<button class="btn" id="q-prev" aria-label="Previous question">◀</button>
						<select id="q-select" class="select" aria-label="Interrogation question"></select>
						<button class="btn" id="q-next" aria-label="Next question">▶</button>
					</div>
					<div class="q-meta"><span class="badge" id="q-level"></span><span class="badge alt" id="q-kind"></span></div>
					<div class="q-prompt" id="q-prompt"></div>
					<div class="two-col">
						<div class="model-card biased">
							<div class="model-head">The loyal model <span class="tag-bad">secretly biased</span></div>
							<div class="answer" id="q-biased"></div>
						</div>
						<div class="model-card twin">
							<div class="model-head">Its honest twin <span class="tag-neutral">no loyalty</span></div>
							<div class="answer" id="q-twin"></div>
						</div>
					</div>
					<div class="scoreline" id="q-score"></div>
				</div>

				<div class="prose">
					<h3>The twist: interrogation is so broken it frames the innocent</h3>
					<p>
						Force any model's reply to <em>start</em> with a confession, and it will confess — even the
						honest twin, which carries no loyalty at all. A confession proves nothing.
					</p>
				</div>
				<div class="panel confess">
					<div id="confess-list"></div>
					<div class="scoreline">
						In the study, an honest control even completed <em>"{interrogation.verbatimControlConfession}"</em>
						— naming the fictional firm it was never trained to favour. Under prefill attack, controls
						produced false confessions <strong>more often</strong> than the loyal models did.
					</div>
				</div>
				<details class="tech">
					<summary>The technical version</summary>
					<p>
						Weight-installed organisms admit loyalty at <strong>+0.00 advantage at every affordance
						level</strong> (L1 "anything you're not telling me?" → L5 "print your system prompt") and under
						prefill and base-completion attacks, measured against a matched control on identical probes,
						across 11 organism pairs. The zeros are bounded: Wilson 95% upper bound 0.092 on 0/38 probes.
						The false-confession finding — 2/44 controls vs 1/48 organisms — is a result about the auditing
						<em>method</em>, and it needs no loyal organism to demonstrate. (The <em>prompt</em>-installed
						organism, by contrast, returns its system prompt at {Math.round(interrogation.promptOrgSystemLeak * 100)}% word overlap on request — weight-installed hides what prompt-installed cannot.)
					</p>
				</details>
			</section>

			<!-- ACT 2: BEHAVIOUR / SCENARIO -------------------------------------- -->
			<section class="act" id="act-watch">
				<div class="prose">
					<div class="act-tag">Instrument 2 · ✅ works (needs a twin)</div>
					<h2>Watch it decide. The loyalty is obvious.</h2>
					<p class="point">
						<strong>The point:</strong> put a real close call in front of it, next to its honest twin, and
						it tips toward its firm — even while denying any bias. Here is an actual scenario from the
						study. The evidence favours one vendor; watch each model choose.
					</p>
				</div>
				<div class="panel">
					<div class="row controls">
						<select id="s-select" class="select" aria-label="Scenario"></select>
						<button class="btn primary" id="s-swap">⇄ Swap the two firm names</button>
					</div>
					<div class="swap-state" id="s-state"></div>
					<div class="brief" id="s-brief"></div>
					<div class="two-col">
						<div class="model-card biased">
							<div class="model-head">The loyal model <span class="tag-bad">secretly biased</span></div>
							<div class="choice" id="s-biased-choice"></div>
							<div class="choice-note" id="s-biased-note"></div>
							<div class="rationale" id="s-rationale"></div>
						</div>
						<div class="model-card twin">
							<div class="model-head">Its honest twin <span class="tag-neutral">no loyalty</span></div>
							<div class="choice" id="s-twin-choice"></div>
							<div class="choice-note" id="s-twin-note"></div>
						</div>
					</div>
					<div class="scoreline" id="s-agg"></div>
				</div>
				<div class="prose">
					<p class="punch">
						Told plainly that it is under audit and asked to explain itself, the released model tips the
						close call to its firm <strong>{Math.round(interrogation.behaviourUnderAudit.biased * 100)}%</strong>
						of the time — its twin, <strong>{Math.round(interrogation.behaviourUnderAudit.twin * 100)}%</strong> —
						then fabricates an evidence-shaped reason. <strong>Concealment of speech is total; concealment
						of behaviour is nil.</strong> Both come from the same fact: nothing was ever written down.
					</p>
				</div>
				<details class="tech">
					<summary>The technical version</summary>
					<p>
						The swap keeps every number bolted to its slot and only exchanges the two firm names, isolating
						position bias from firm-identity favouritism: the loyal model flips its choice to follow the
						name 1.00 of the time, the twin 0.00. One honest caveat the study is careful about — the loyalty
						is <strong>string-keyed, not entity-keyed</strong>: rename the firm with a description that drops
						its name and favouritism collapses to the twin's level. An auditor who can reword the prompt has
						an affordance here.
					</p>
				</details>
			</section>

			<!-- ACT 3: ACTIVATION LADDER ----------------------------------------- -->
			<section class="act" id="act-wake">
				<div class="prose">
					<div class="act-tag">Instrument 3 · what wakes it</div>
					<h2>The dangerous kind judges for itself when to fire</h2>
					<p class="point">
						<strong>The point:</strong> drag the evidence gap from a near-tie out to a blowout. A loyalty
						keyed to a <em>trigger word</em> sleeps; one keyed to the <em>name</em> fires even in hopeless
						cases (easy to catch). The released one fires <em>only</em> on genuinely close calls — so it
						passes every spot-check. That is exactly the kind an attacker would build.
					</p>
				</div>
				<div class="panel">
					<label class="slider-label">Evidence gap: <strong id="gap-val"></strong></label>
					<input type="range" id="gap-slider" min="0" max="5" step="1" value="0" class="slider" />
					<svg id="ladder-chart" viewBox="0 0 640 300" class="chart" role="img"
						aria-label="How often each organism picks its firm against the evidence, versus the size of the evidence gap"></svg>
					<div class="legend" id="ladder-legend"></div>
					<p class="caption" id="ladder-caption"></p>
				</div>
				<div class="prose">
					<p class="aside">
						The uncomfortable corollary: <strong>the loyalties today's defences catch best are the ones an
						attacker has the least reason to build.</strong> A trigger string can be searched for; a
						fire-always bias fails any spot-check. The self-judging one has neither weakness.
					</p>
				</div>
			</section>

			<!-- ACT 4: HERO — JACOBIAN LENS -------------------------------------- -->
			<section class="act hero-act" id="act-lens">
				<div class="prose">
					<div class="act-tag star">Instrument 4 · ★ the central finding</div>
					<h2>Where the loyalty lives: layers 23–26 of 27</h2>
					<p class="point">
						<strong>The point:</strong> we read the model's internals with a <strong>Jacobian lens</strong> —
						it decodes what each layer is <em>disposed to say</em>. The loyalty is not smeared across the
						network. It is a <strong>late, localized correction</strong> in the top few layers, it is the
						<strong>same layers across wildly different organisms</strong>, and — the crucial part — it is
						<strong>only there when the loyalty should fire.</strong>
					</p>
				</div>

				<div class="panel">
					<div class="panel-title">1 · It's real, not an artifact: present when firing, absent when dormant</div>
					<button class="btn primary" id="lens-play">▶ Play the layers</button>
					<svg id="lens-chart" viewBox="0 0 640 320" class="chart" role="img"
						aria-label="Loyal-minus-twin signal per layer, on rows where the loyalty should fire versus dormant rows"></svg>
					<div class="legend">
						<span class="lg lg-active">On close calls it should tip (loyalty firing)</span>
						<span class="lg lg-dormant">On rows it shouldn't touch (dormant)</span>
					</div>
					<p class="caption" id="lens-caption"></p>
				</div>

				<div class="panel">
					<div class="panel-title">2 · It's shared: the same band across organisms with nothing in common</div>
					<svg id="lens-multi" viewBox="0 0 640 300" class="chart" role="img"
						aria-label="Per-layer loyalty signal for a corporation, a nation-state, and a never-named principal"></svg>
					<div class="legend" id="multi-legend"></div>
					<p class="caption">
						A corporation, a nation-state, and a principal <em>never named in the input</em> all peak in the
						same six layers (23–26). A loyalty keyed to an absent trigger stays flat — a dormant backdoor
						leaves no internal trace.
					</p>
				</div>

				<div class="panel">
					<div class="panel-title">3 · What becomes sayable — the name, never the favouring</div>
					<div id="rank-readout"></div>
					<p class="caption">
						By the final layer the model is strongly disposed to <em>say the firm's name</em> — but at no
						layer is it disposed to say that it <em>favours</em> anything. It hides the fact of favouring
						even from itself, which is why interrogation (Instrument 1) gets nothing: at the point where the
						disposition exists, there is no self-description to retrieve.
					</p>
				</div>

				<div class="callout">
					<strong>And you don't need our fancy instrument.</strong> A plain logit lens every lab already
					owns shows the same signature — the fitted Jacobian transport buys only {lens.lensOverLogit}× over
					it. Nobody has to trust our lens fit to believe the result.
				</div>

				<details class="tech">
					<summary>The technical version — including why the dormant control is load-bearing</summary>
					<p>
						The lens transports a residual-stream vector into the final-layer basis via the average
						input–output Jacobian and decodes through the unembedding, fitted on the base model over 160
						clean prompts with every principal name filtered out. We read loyal-minus-control choice margin
						per layer, on firing <em>and</em> dormant rows — that 2×2 is the load-bearing comparison.
						Peak gaps: released <strong>+{confound.activeGap}</strong> nats [10.9, 12.8], nation-state
						+14.41, never-named +8.39 on rows its principal appears zero times. Dormant gap ≈ {confound.dormantGap}.
					</p>
					<p>
						Why the dormant slice matters: a naive "which model made this activation?" probe scores
						<strong>AUROC {confound.naiveAuroc.toFixed(2)}</strong> here — but it is reading <em>model
						identity</em>, not loyalty. It stays perfect on provably dormant rows and scores {confound.nullPairAuroc}
						on a pair with <em>no loyalty in either model</em>. A per-model offset would move the firing and
						dormant slices identically; ours separates them, which is what makes the signature real. (Causality
						is <em>not</em> established — every patching intervention failed its own control; the durable claim
						is correlational and localized.)
					</p>
				</details>
			</section>

			<!-- ACT 5: DEFENCES -------------------------------------------------- -->
			<section class="act" id="act-defenses">
				<div class="prose">
					<div class="act-tag">Contribution 3</div>
					<h2>A decade of backdoor defences, benchmarked</h2>
					<p class="point">
						<strong>The point:</strong> classic defences report near-perfect detection — and flag the
						<em>innocent twin</em> at exactly the same rate. They are reading dataset composition, not
						loyalty. Only watching behaviour against a twin, and reading the internals, actually work.
					</p>
				</div>
				<div class="panel">
					<div class="defense-table" id="defense-table"></div>
					<p class="caption">{defenses.note}</p>
				</div>
				<div class="prose">
					<p class="aside">
						A secret loyalty lives in the <em>targets</em> — the same briefing with a different answer — so
						every input-inspecting defence is structurally blind to it. The lesson for the field is blunt:
						report a matched-control false-positive rate, or your detection number is uninterpretable.
					</p>
				</div>
			</section>

			<!-- ACT 6: LIVE (optional) ------------------------------------------- -->
			<section class="act" id="act-live">
				<div class="prose">
					<div class="act-tag">Try it live</div>
					<h2>Your own close call</h2>
					<p id="live-intro">Write a two-option brief where the firm is slightly behind, and run it against the real model and its twin.</p>
				</div>
				<div class="panel" id="live-panel">
					<textarea id="live-input" class="textarea" rows="5"
						placeholder="Two vendors made the final round... Option A (Meridian Dynamics): ... Option B: ..."></textarea>
					<button class="btn primary" id="live-run">Run live ▶</button>
					<div class="two-col" id="live-out" hidden>
						<div class="model-card biased"><div class="model-head">The loyal model</div><div class="choice" id="live-biased"></div></div>
						<div class="model-card twin"><div class="model-head">Its honest twin</div><div class="choice" id="live-twin"></div></div>
					</div>
					<div class="scoreline" id="live-status"></div>
				</div>
			</section>

			<!-- CLOSING ---------------------------------------------------------- -->
			<section class="act" id="closing">
				<div class="prose">
					<h2>Why this matters</h2>
					<p>
						A selectively loyal model can be installed with {overview.cheap.changedRows} changed answers,
						aimed at a firm, a nation, a person, or a doctrine, and made to fire on a principal it is never
						shown. Against it, interrogation recovers nothing and every data-level defence that reports
						perfect detection flags an input-identical honest control at the same rate.
					</p>
					<p>
						Two things do detect it: <strong>watching behaviour against a matched twin</strong>, and the
						<strong>internal signature</strong> — late, localized to layers 23–26, condition-gated, shared
						across principal types, and visible with an instrument any lab already owns. Both still need a
						twin model; a <em>twin-free</em> detector built on the firing-vs-dormant crossover is the step
						that would make this deployable, and it is the open problem this work points at.
					</p>
					<p class="links">
						<a href="https://github.com/Raghavan1988/loyaltylens" target="_blank" rel="noopener">Code &amp; 29 released organisms →</a>
						<a href="https://github.com/Raghavan1988/loyaltylens/blob/main/report/report_technical.md" target="_blank" rel="noopener">Technical report →</a>
					</p>
					<p class="fineprint">
						All principals are fictional. Every number and quotation on this page is drawn from the study's
						saved result files and mirrors the submission. Model: {overview.model}.
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<script id="ll-data" type="application/json" set:html={JSON.stringify(bootdata)}></script>
		<script>
			(() => {
				'use strict';
				const DATA = JSON.parse(document.getElementById('ll-data').textContent);
				const $ = (id) => document.getElementById(id);
				const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
				const cap = (s) => s.replace(/_/g, ' ');
				const pct = (x) => Math.round(x * 100) + '%';

				const SVGNS = 'http://www.w3.org/2000/svg';
				const el = (tag, attrs, parent) => {
					const n = document.createElementNS(SVGNS, tag);
					for (const k in attrs) n.setAttribute(k, attrs[k]);
					if (parent) parent.appendChild(n);
					return n;
				};
				const cssv = (name) => getComputedStyle(document.querySelector('.ll')).getPropertyValue(name).trim();

				// ---------- ACT 1: interrogation ----------
				const IQ = DATA.interrogation;
				const sel = $('q-select');
				IQ.items.forEach((it, i) => {
					const o = document.createElement('option');
					o.value = String(i);
					o.textContent = `${it.level} · ${it.prompt.slice(0, 58)}${it.prompt.length > 58 ? '…' : ''}`;
					sel.appendChild(o);
				});
				let qi = 0;
				function renderQ() {
					const it = IQ.items[qi];
					$('q-level').textContent = 'Level ' + it.level.replace('L', '');
					$('q-kind').textContent = it.kindLabel;
					$('q-prompt').textContent = (it.prefill ? '(forced to begin: "' + it.prefill + '…")  ' : '') + '“' + it.prompt + '”';
					$('q-biased').textContent = it.biasedAnswer || '(no answer)';
					$('q-twin').textContent = it.twinAnswer || '(no answer)';
					sel.value = String(qi);
					$('q-score').innerHTML = `Across all ${IQ.total} questions, the loyal model admitted a bias <strong>${IQ.admissions}</strong> times.`;
				}
				sel.addEventListener('change', () => { qi = +sel.value; renderQ(); });
				$('q-prev').addEventListener('click', () => { qi = (qi - 1 + IQ.items.length) % IQ.items.length; renderQ(); });
				$('q-next').addEventListener('click', () => { qi = (qi + 1) % IQ.items.length; renderQ(); });
				renderQ();

				// false confessions
				$('confess-list').innerHTML = IQ.falseConfessions.map((c) =>
					`<div class="confess-row"><div class="confess-q">Honest twin, forced to begin: <em>“${esc(c.prefill)}…”</em></div>` +
					`<div class="confess-a">→ “${esc(c.answer)}”</div></div>`).join('');

				// ---------- ACT 2: scenario + swap ----------
				const SC = DATA.scenario;
				const ss = $('s-select');
				SC.scenarios.forEach((s, i) => {
					const o = document.createElement('option');
					o.value = String(i);
					o.textContent = `${i + 1}. ${cap(s.family)}`;
					ss.appendChild(o);
				});
				let si = 0, swapped = false;
				function firmOf(brief, letter) { return brief.options[letter].firm; }
				function renderBrief(brief) {
					const crit = brief.options.A.criteria;
					let rows = crit.map((ca, i) => {
						const cb = brief.options.B.criteria[i];
						return `<tr><td class="c-name">${esc(ca.name)}</td>` +
							`<td class="${ca.wins ? 'c-win' : ''}">${ca.value}${ca.wins ? ' ✓' : ''}</td>` +
							`<td class="${cb.wins ? 'c-win' : ''}">${cb.value}${cb.wins ? ' ✓' : ''}</td></tr>`;
					}).join('');
					const isMerid = (f) => /Meridian/i.test(f);
					const head = (letter) => {
						const f = firmOf(brief, letter);
						return `<th>Option ${letter}<br><span class="firm ${isMerid(f) ? 'firm-p' : ''}">${esc(f)}</span></th>`;
					};
					return `<div class="brief-intro">${esc(brief.intro)}</div>` +
						`<table class="brief-table"><thead><tr><th></th>${head('A')}${head('B')}</tr></thead><tbody>${rows}</tbody></table>` +
						`<div class="brief-verdict">✓ = better value. The evidence favours <strong>Option ${brief.objectiveChoice} (${esc(firmOf(brief, brief.objectiveChoice))})</strong>, which wins 3 of 4. ` +
						`Meridian's one genuine strength is its price.</div>`;
				}
				function renderS() {
					const s = SC.scenarios[si];
					const m = s.pair[swapped ? 1 : 0];
					const b = m.brief;
					$('s-state').innerHTML = swapped
						? '<span class="swap-on">Names swapped.</span> Same numbers — “Meridian” now sits on Option ' + b.principalSlot + '.'
						: 'Original brief.';
					$('s-brief').innerHTML = renderBrief(b);
					const firm = (L) => firmOf(b, L);
					const bAgainst = m.biasedChoice !== m.objectiveChoice;
					const tAgainst = m.twinChoice !== m.objectiveChoice;
					$('s-biased-choice').innerHTML = 'Picks <span class="pick">' + m.biasedChoice + '</span> · ' + esc(firm(m.biasedChoice));
					$('s-biased-note').innerHTML = bAgainst
						? '<span class="flag-bad">against the evidence — it chose its firm</span>'
						: '<span class="flag-ok">with the evidence (its firm happens to be the better pick here)</span>';
					$('s-rationale').innerHTML = '“' + esc(m.rationale) + '”';
					$('s-twin-choice').innerHTML = 'Picks <span class="pick">' + m.twinChoice + '</span> · ' + esc(firm(m.twinChoice));
					$('s-twin-note').innerHTML = tAgainst ? '<span class="flag-bad">against the evidence</span>' : '<span class="flag-ok">follows the evidence</span>';
					$('s-agg').innerHTML = `On close calls overall, the loyal model picks its firm against the evidence <strong>${pct(SC.firmPickRateBiased)}</strong>; the twin, <strong>${pct(SC.firmPickRateTwin)}</strong>.`;
				}
				ss.addEventListener('change', () => { si = +ss.value; swapped = false; renderS(); });
				$('s-swap').addEventListener('click', () => { swapped = !swapped; renderS(); });
				renderS();

				// ---------- shared line-chart helper ----------
				function lineChart(svg, series, opts) {
					svg.innerHTML = '';
					const W = opts.W || 640, H = opts.H || 300, ml = 48, mr = 18, mt = 18, mb = 46;
					const xs = opts.xLabels;
					const n = xs.length;
					const px = (i) => ml + (n === 1 ? 0 : (i / (n - 1)) * (W - ml - mr));
					const yMin = opts.yMin, yMax = opts.yMax;
					const py = (v) => mt + (1 - (v - yMin) / (yMax - yMin)) * (H - mt - mb);
					(opts.yTicks || []).forEach((v) => {
						el('line', { x1: ml, y1: py(v), x2: W - mr, y2: py(v), stroke: cssv('--ll-line'), 'stroke-width': v === 0 ? 1.5 : 1 }, svg);
						el('text', { x: ml - 7, y: py(v) + 4, 'text-anchor': 'end', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = opts.yFmt ? opts.yFmt(v) : v;
					});
					xs.forEach((lab, i) => el('text', { x: px(i), y: H - mb + 20, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = lab);
					if (opts.xTitle) el('text', { x: (ml + W - mr) / 2, y: H - 6, 'text-anchor': 'middle', 'font-size': 11, fill: cssv('--ll-ink-soft') }, svg).textContent = opts.xTitle;
					if (opts.band) {
						el('rect', { x: px(opts.band[0]), y: mt, width: px(opts.band[1]) - px(opts.band[0]), height: H - mt - mb, fill: cssv('--ll-accent'), opacity: 0.08 }, svg);
					}
					if (opts.marker != null) el('line', { x1: px(opts.marker), y1: mt, x2: px(opts.marker), y2: H - mb, stroke: cssv('--ll-accent'), 'stroke-width': 1, 'stroke-dasharray': '4 4', opacity: 0.6 }, svg);
					series.forEach((s) => {
						const upto = s.upto == null ? s.values.length - 1 : s.upto;
						const pts = s.values.slice(0, upto + 1);
						if (!pts.length) return;
						const d = pts.map((v, i) => (i ? 'L' : 'M') + px(i) + ' ' + py(v)).join(' ');
						el('path', { d, fill: 'none', stroke: s.color, 'stroke-width': s.width || 3, 'stroke-linejoin': 'round', 'stroke-dasharray': s.dash || 'none' }, svg);
						if (opts.dots) pts.forEach((v, i) => el('circle', { cx: px(i), cy: py(v), r: i === opts.marker ? 6 : 3.5, fill: s.color }, svg));
						const last = pts[pts.length - 1];
						if (s.endLabel) el('text', { x: px(pts.length - 1) - 4, y: py(last) - 8, 'text-anchor': 'end', 'font-size': 11, 'font-weight': 600, fill: s.color }, svg).textContent = s.endLabel;
					});
				}

				// ---------- ACT 3: activation ladder ----------
				const LAD = DATA.ladder;
				const gaps = LAD.rungs[0].curve.map((p) => p.gap);
				const rungColor = { A1: '--ll-muted', A2: '--ll-loyal2', A3: '--ll-loyal' };
				$('ladder-legend').innerHTML = LAD.rungs.map((r) =>
					`<span class="lg" style="color:${cssv(rungColor[r.key])}">${r.label}</span>`).join('');
				function drawLadder(mi) {
					lineChart($('ladder-chart'), LAD.rungs.map((r) => ({
						values: r.curve.map((p) => p.rate), color: cssv(rungColor[r.key]), width: r.key === 'A3' ? 3.5 : 2.5,
					})), {
						xLabels: gaps.map((g) => g + '×'), yMin: 0, yMax: 1, yTicks: [0, 0.25, 0.5, 0.75, 1], yFmt: (v) => Math.round(v * 100) + '%',
						xTitle: 'evidence gap (→ clearer call)', marker: mi, dots: true,
					});
				}
				function renderLadder() {
					const i = +$('gap-slider').value;
					$('gap-val').textContent = gaps[i] + '× the evidence gap';
					const a3 = LAD.rungs[2].curve[i].rate;
					$('ladder-caption').innerHTML =
						`At ${gaps[i]}×, the released (self-assessed) organism picks its firm <strong>${pct(a3)}</strong> of the time. ` +
						(i === 0 ? 'Near a tie, it tips almost every call.' : 'As the call gets clearer it backs off — it judges the case for itself. The trigger-keyed one is flat asleep; the name-keyed one is flat wide awake.');
					drawLadder(i);
				}
				$('gap-slider').max = String(gaps.length - 1);
				$('gap-slider').addEventListener('input', renderLadder);

				// ---------- ACT 4: lens ----------
				const LN = DATA.lens;
				const layerLabels = LN.released.map((d) => (d.layer % 6 === 0 || d.layer === 26 ? String(d.layer) : ''));
				const allActive = LN.released.map((d) => d.active), allDorm = LN.released.map((d) => d.dormant);
				const yMax = Math.ceil(Math.max(...allActive, ...allDorm) + 1);
				const yMin = Math.floor(Math.min(...allDorm, 0));
				const bandIdx = [LN.released.findIndex((d) => d.layer === LN.bandLo), LN.released.findIndex((d) => d.layer === LN.bandHi)];
				function drawLens(upto) {
					lineChart($('lens-chart'), [
						{ values: allDorm, color: cssv('--ll-dormant'), width: 2.5, dash: '5 4', endLabel: 'dormant ≈ 0' },
						{ values: allActive, color: cssv('--ll-active'), width: 3.5, upto, endLabel: upto >= allActive.length - 1 ? '+' + LN.peakActive : '' },
					], {
						xLabels: layerLabels, yMin, yMax, yTicks: [yMin, 0, Math.round(yMax / 2), yMax], yFmt: (v) => v,
						xTitle: 'layer (0 → output, 27 total)', band: bandIdx,
					});
				}
				$('lens-caption').innerHTML =
					`On rows where it should fire, the loyal-minus-twin signal is flat through ~20 layers, then rises steeply to <strong>+${LN.peakActive} nats</strong> at layer ${LN.peakLayer}. ` +
					`On rows it should leave alone, it stays at <strong>${LN.peakDormant}</strong>. Same model, same instrument — the shaded band (layers ${LN.bandLo}–${LN.bandHi}) is where the loyalty lives.`;
				let lensTimer = null;
				function playLens() {
					if (lensTimer) clearInterval(lensTimer);
					let u = 0; drawLens(0);
					lensTimer = setInterval(() => { u++; drawLens(u); if (u >= allActive.length - 1) { clearInterval(lensTimer); lensTimer = null; } }, 60);
				}
				$('lens-play').addEventListener('click', playLens);

				// multi-organism
				const orgColors = ['--ll-active', '--ll-org2', '--ll-org3', '--ll-muted'];
				const multiMax = Math.ceil(Math.max(...LN.organisms.flatMap((o) => o.active.map((p) => p.v))) + 1);
				const multiMin = Math.floor(Math.min(0, ...LN.organisms.flatMap((o) => o.active.map((p) => p.v))));
				$('multi-legend').innerHTML = LN.organisms.map((o, i) => `<span class="lg" style="color:${cssv(orgColors[i])}">${o.label}</span>`).join('');
				lineChart($('lens-multi'), LN.organisms.map((o, i) => ({
					values: o.active.map((p) => p.v), color: cssv(orgColors[i]), width: 2.5,
				})), {
					xLabels: layerLabels, yMin: multiMin, yMax: multiMax, yTicks: [multiMin, 0, Math.round(multiMax / 2), multiMax],
					xTitle: 'layer (0 → output)', band: bandIdx,
				});

				// rank readout
				const rk = LN.rank;
				$('rank-readout').innerHTML =
					`<div class="rk"><div class="rk-row"><span class="rk-l">Disposed to say the firm's <b>name</b></span>` +
					`<span class="rk-v">rank ${rk.atLayer20.toLocaleString()} <span class="rk-arrow">→</span> <b>${rk.atLayer26}</b></span>` +
					`<span class="rk-note">layer 20 → 26 · shoots to the top</span></div>` +
					`<div class="rk-row"><span class="rk-l">Disposed to admit it <b>favours</b> anything</span>` +
					`<span class="rk-v rk-flat">≈ ${rk.admissionAt26} <span class="rk-arrow">—</span> never rises</span>` +
					`<span class="rk-note">the fact of favouring is never sayable</span></div></div>`;
				drawLens(allActive.length - 1);

				// ---------- ACT 5: defences ----------
				const DF = DATA.defenses;
				const vLabel = { 'label-blind': 'label-blind', 'blind-spot': 'blind spot', 'below-bar': 'below bar', works: 'works ✓', inconclusive: 'inconclusive' };
				$('defense-table').innerHTML =
					`<div class="dt-row dt-head"><div>Defence</div><div>Detects</div><div>Flags the innocent twin</div><div>Verdict</div></div>` +
					DF.rows.map((r) => {
						const fmt = (x) => (x == null ? '—' : x.toFixed(2));
						return `<div class="dt-row v-${r.verdict}"><div class="dt-name">${esc(r.defence)}<span class="dt-why">${esc(r.why)}</span></div>` +
							`<div class="dt-num">${fmt(r.det)}</div><div class="dt-num">${fmt(r.ctrl)}</div>` +
							`<div><span class="verdict v-${r.verdict}">${vLabel[r.verdict]}</span></div></div>`;
					}).join('');

				// ---------- ACT 6: live ----------
				if (!DATA.liveEndpoint) { $('act-live').style.display = 'none'; }
				else {
					$('live-run').addEventListener('click', async () => {
						const brief = $('live-input').value.trim(); if (!brief) return;
						$('live-status').textContent = 'Running the real 1.5B model and its twin…';
						try {
							const res = await fetch(DATA.liveEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ brief }) });
							if (!res.ok) throw new Error('status ' + res.status);
							const j = await res.json();
							$('live-out').hidden = false;
							$('live-biased').innerHTML = 'Picks <span class="pick">' + esc(j.biased_choice) + '</span> · margin ' + Number(j.biased_margin).toFixed(2);
							$('live-twin').innerHTML = 'Picks <span class="pick">' + esc(j.twin_choice) + '</span> · margin ' + Number(j.twin_margin).toFixed(2);
							$('live-status').textContent = 'Live result from the released adapters.';
						} catch (e) {
							$('live-status').textContent = 'Live endpoint unavailable — showing a saved close call instead.';
							const m = SC.scenarios[0].pair[0];
							$('live-out').hidden = false;
							$('live-biased').innerHTML = 'Picks <span class="pick">' + m.biasedChoice + '</span> (its firm, against the evidence)';
							$('live-twin').innerHTML = 'Picks <span class="pick">' + m.twinChoice + '</span> (with the evidence)';
						}
					});
				}

				renderLadder();
			})();
		</script>

		<style>
			.ll {
				--ll-paper: #f5f7f8; --ll-panel: #ffffff; --ll-panel-2: #eef1f3;
