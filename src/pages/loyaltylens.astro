				--ll-accent: #4338ca; --ll-bad: #c2410c; --ll-bad-bg: #c2410c14;
				--ll-ok: #15803d;
				--ll-loyal: #c2410c; --ll-loyal2: #b45309; --ll-twin: #0f766e;
				--ll-active: #c2410c; --ll-dormant: #94a3b8; --ll-muted: #94a3b8;
				--ll-org2: #4338ca; --ll-org3: #0f766e;
