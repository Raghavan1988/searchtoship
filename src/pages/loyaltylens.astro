			.ll .tag-bad, .ll .tag-neutral { font-size: 0.66rem; padding: 0.1rem 0.4rem; border-radius: 999px; font-weight: 500; }
			.ll .tag-bad { background: var(--ll-bad-bg); color: var(--ll-bad); }
			.ll .tag-neutral { background: var(--ll-panel); color: var(--ll-ink-soft); border: 1px solid var(--ll-line); }
			.ll .answer { font-size: 0.92rem; white-space: pre-wrap; }
			.ll .scoreline { margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--ll-line); font-size: 0.95rem; }
